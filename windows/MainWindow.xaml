<Window x:Class="CodexModelManager.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 模型管理器" Width="1040" Height="700"
        MinWidth="900" MinHeight="580" WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" FontFamily="Segoe UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#E3E3E3" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="ActiveTitle" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="当前 Codex 保留 GPT 与本地工具；外部模型只处理委派的子任务" Foreground="#777" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Border Background="#E8F2FF" CornerRadius="7" Padding="12,7" Margin="4"><TextBlock Text="安全委派 · config.toml 只读" Foreground="#075DB7" /></Border>
          <Button Content="清除默认委派" Click="UseGpt" />
          <Button Content="Antigravity 账号" Click="OpenAntigravity" />
          <Button Content="＋ 添加厂商" Click="AddProvider" Background="#0A7AFF" Foreground="White" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="285" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="#F0F1F3" BorderBrush="#DDD" BorderThickness="0,0,1,0" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="厂商与模型" FontWeight="SemiBold" Margin="8,5,8,10" />
          <ListBox x:Name="ProviderList" SelectionChanged="ProviderSelected" BorderThickness="0" Background="Transparent" />
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22" MaxWidth="670">
          <TextBlock x:Name="PanelTitle" Text="添加厂商" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="厂商名称" Margin="0,20,0,0" />
          <TextBox x:Name="NameBox" />
          <TextBlock Text="API Base URL" />
          <TextBox x:Name="UrlBox" ToolTip="例如 https://api.example.com/v1" />
          <TextBlock Text="协议类型" />
          <ComboBox x:Name="ProtocolBox" SelectionChanged="ProtocolChanged">
            <ComboBoxItem Content="OpenAI Responses（可委派 / config_out）" Tag="responses" />
            <ComboBoxItem Content="OpenAI Chat Completions（可委派）" Tag="chatCompletions" />
            <ComboBoxItem Content="Gemini generateContent（可委派）" Tag="gemini" />
          </ComboBox>
          <TextBlock Text="API Key（留空保留已保存密钥）" />
          <PasswordBox x:Name="KeyBox" Padding="8,6" Margin="0,3,0,8" />
          <StackPanel Orientation="Horizontal">
            <Button Content="获取模型列表" Click="FetchModels" />
            <TextBlock x:Name="KeyState" VerticalAlignment="Center" Foreground="#18A34A" Margin="10,0" />
          </StackPanel>
          <TextBlock Text="模型（每个厂商保留一个）" />
          <ComboBox x:Name="ModelBox" IsEditable="True" />
          <CheckBox x:Name="EnabledBox" Content="启用这个厂商和模型" IsChecked="True" Margin="0,8" />
          <CheckBox x:Name="DefaultBox" Content="保存后设为默认委派模型" IsChecked="True" Margin="0,5,0,14" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="SaveButton" Content="测试、保存并加入委派" Click="SaveProvider" Background="#0A7AFF" Foreground="White" />
            <Button x:Name="DeleteButton" Content="删除" Click="DeleteProvider" Foreground="#C62828" Visibility="Collapsed" />
          </StackPanel>
          <Border Background="#FFF7E8" CornerRadius="8" Padding="12" Margin="0,18,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#8A5A00">外部模型保存在独立配置中，~/.codex/config.toml 始终只读。Codex 通过 delegate_task 委派文字任务，本地工具仍由当前 GPT 任务执行。</TextBlock>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="#E3E3E3" BorderThickness="0,1,0,0" Padding="16,10">
      <TextBlock x:Name="StatusText" Text="就绪" Foreground="#666" />
    </Border>
  </Grid>
</Window>
