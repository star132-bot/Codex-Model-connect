{
  "mcpServers": {
    "model_delegate": {
      "command": "node",
      "args": ["./mcp/server.mjs"],
      "cwd": ".",
      "enabled": true,
      "env_vars": ["CODEX_HOME", "HOME", "USERPROFILE", "LOCALAPPDATA", "PATH"],
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 3600,
      "tools": {
        "delegate_task": { "output_token_limit": 32768 }
      }
    }
  }
}
